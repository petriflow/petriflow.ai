<?xml version="1.0" encoding="UTF-8"?>
<document xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://modeler.netgrif.com/petriflow_schema.xsd">
	<id>committee_01</id>
	<initials>KMS</initials>
	<title>Committee V01</title>
	<defaultRole>false</defaultRole>
	<transitionRole>false</transitionRole>
	<!-- ROLES -->
	<!-- DATA -->
	<data type="text">
		<id>chair_first_name</id>
		<title>Committee chair's first name</title>
		<placeholder>Enter your first name</placeholder>
		<desc>Enter your first name</desc>
	</data>
	<data type="text">
		<id>chair_last_name</id>
		<title>Committee chair's last name</title>
		<placeholder>Enter your last name</placeholder>
		<desc>Enter your last name</desc>
	</data>
	<data type="text">
		<id>chair_email</id>
		<title>Committee chair's email address</title>
		<placeholder>Enter your email address</placeholder>
		<desc>Committee chair's email address</desc>
	</data>
	<data type="multichoice_map">
		<id>multichoice_0</id>
		<title>Submitted theses</title>
		<placeholder>placeholder</placeholder>
		<desc>description</desc>
		<options>			
		<option key="option1">Option 1</option>
		<option key="option2">Option 2</option>
		<option key="option3">Option 3</option>
		</options>
	</data>
	<data type="taskRef">
		<id>defenses</id>
		<title>Defenses</title>
	</data>
	<data type="taskRef">
		<id>chair</id>
		<title>Committee chair</title>
	</data>
	<data type="userList">
		<id>autor</id>
		<title/>
	</data>
	<!-- TRANSITIONS -->
	<transition>
		<id>t1</id>
		<x>180</x>
		<y>20</y>
		<layout>
			<offset>0</offset>
		</layout>
		<label>Chair</label>
		<dataGroup>
			<id>DataGroup_0</id>
			<dataRef>
				<id>chair_first_name</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>2</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>chair_last_name</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>2</x>
					<y>0</y>
					<rows>1</rows>
					<cols>2</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>chair_email</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
	</transition>
	<transition>
		<id>t2</id>
		<x>100</x>
		<y>100</y>
		<layout>
			<offset>0</offset>
		</layout>
		<label>Init</label>
		<trigger type="auto"/>
		<event type="finish">
			<id>t2_finish</id>
			<actions phase="pre">
				<action>
				first_name: f.chair_first_name,
				last_name: f.chair_last_name,
				email: f.chair_email,
				chair: f.chair,
				autor: f.autor;
				change first_name value {userService.loggedOrSystem.name}
				change last_name value {userService.loggedOrSystem.surname}
				change email value {userService.loggedOrSystem.email}
				change chair value {[useCase.tasks.find{it.transition=="t1"}?.task]}
				change autor value {
						[userService.getLoggedOrSystem().id]
					}
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>t3</id>
		<x>260</x>
		<y>100</y>
		<layout>
			<offset>0</offset>
		</layout>
		<label>Select theses for the committee</label>
		<usersRef>
			<id>autor</id>
			<logic>
				<perform>true</perform>
			</logic>
		</usersRef>
		<dataGroup>
			<id>DataGroup_0</id>
			<dataRef>
				<id>chair</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<dataGroup>
			<id>DataGroup_1</id>
			<dataRef>
				<id>multichoice_0</id>
				<logic>
					<behavior>editable</behavior>
					<action trigger="get">
					theses: f.this;
					def submitted_theses = findCases { it.processIdentifier.eq("601fdf0a0a975a3b82912fd5_thesis").and(it.activePlaces.get("p6").eq(1))}.collectEntries { 
						[(it.stringId): "Name: " + it.getFieldValue("thesis_title")  + " Student: " + it.getFieldValue("student_first_name") + " " + it.getFieldValue("student_last_name")] 
					}
					change theses options {
						submitted_theses
					}
					</action>
					<action trigger="set">
					defenses: f.defenses,
					theses: f.this;
					change defenses value {
					findTasks {it.caseId.in(theses.value).and(it.transitionId.eq("t8"))}?.collect{it.stringId}
					}
					</action>
				</logic>
				<layout>
					<x>0</x>
					<y>2</y>
					<rows>2</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
	</transition>
	<transition>
		<id>t4</id>
		<x>500</x>
		<y>100</y>
		<layout>
			<offset>0</offset>
		</layout>
		<label>Defenses</label>
		<usersRef>
			<id>autor</id>
			<logic>
				<perform>true</perform>
			</logic>
		</usersRef>
		<dataGroup>
			<id>DataGroup_0</id>
			<dataRef>
				<id>chair</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
			</dataRef>
		</dataGroup>
		<dataGroup>
			<id>DataGroup_1</id>
			<dataRef>
				<id>defenses</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="assign">
			<id>t4_assign</id>
			<actions phase="post">
				<action>
				submission: f.defenses;
				submission.value.each{id -> assignTask(findTask({it._id.eq(id)}))				
				}
				</action>
			</actions>
		</event>
		<event type="cancel">
			<id>t4_cancel</id>
			<actions phase="pre">
				<action>
				submission: f.defenses;
				submission.value.each{id -> cancelTask(findTask({it._id.eq(id)}))				
				}</action>
			</actions>
		</event>
		<event type="finish">
			<id>t4_finish</id>
			<actions phase="pre">
				<action>
				submission: f.defenses;
				submission.value.each{id -> finishTask(findTask({it._id.eq(id)}))
				}</action>
			</actions>
		</event>
	</transition>
	<!-- PLACES -->
	<place>
		<id>p1</id>
		<x>20</x>
		<y>100</y>
		<label></label>
		<tokens>1</tokens>
		<static>false</static>
	</place>
	<place>
		<id>p2</id>
		<x>180</x>
		<y>100</y>
		<label></label>
		<tokens>0</tokens>
		<static>false</static>
	</place>
	<place>
		<id>p3</id>
		<x>380</x>
		<y>100</y>
		<label></label>
		<tokens>0</tokens>
		<static>false</static>
	</place>
	<place>
		<id>p4</id>
		<x>660</x>
		<y>100</y>
		<label></label>
		<tokens>0</tokens>
		<static>false</static>
	</place>
	<!-- ARCS -->
	<arc>
		<id>a1</id>
		<type>regular</type>
		<sourceId>p1</sourceId>
		<destinationId>t2</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
	<arc>
		<id>a2</id>
		<type>regular</type>
		<sourceId>t2</sourceId>
		<destinationId>p2</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
	<arc>
		<id>a3</id>
		<type>regular</type>
		<sourceId>p2</sourceId>
		<destinationId>t3</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
	<arc>
		<id>a4</id>
		<type>regular</type>
		<sourceId>t3</sourceId>
		<destinationId>p3</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
	<arc>
		<id>a5</id>
		<type>regular</type>
		<sourceId>p3</sourceId>
		<destinationId>t4</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
	<arc>
		<id>a6</id>
		<type>regular</type>
		<sourceId>t4</sourceId>
		<destinationId>p4</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
</document>
