	</transition>
	<transition>
		<id>t6</id>
		<x>860</x>
		<y>100</y>
		<layout>
			<offset>0</offset>
		</layout>
		<label>Thesis submission</label>
		<usersRef>
			<id>autor</id>
			<logic>
				<perform>true</perform>
			</logic>
		</usersRef>
		<dataGroup>
			<id>DataGroup_0</id>
			<dataRef>
				<id>thesis_submission_ref</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="assign">
			<id>t6_assign</id>
			<actions phase="pre">
				<action>
					submission_theses: f.thesis_submission_ref,
					topic: f.student_thesis_topics;
					change submission_theses value {
					[findTask {it.caseId.eq(topic.value).and(it.transitionId.eq("t7"))}?.stringId]
					}
			</action>
			</actions>
			<actions phase="post">
				<action>
					submission: f.thesis_submission_ref;
					def task = findTask({it._id.eq(submission.value[0])})
					assignTask(task)
				</action>
			</actions>
		</event>
		<event type="cancel">
			<id>t6_cancel</id>
			<actions phase="pre">
				<action>
					submission: f.thesis_submission_ref;
					def task = findTask({it._id.eq(submission.value[0])})
					cancelTask(task)
				</action>
			</actions>
		</event>
		<event type="finish">
			<id>t6_finish</id>
			<actions phase="pre">
				<action>
					submission: f.thesis_submission_ref;
					def task = findTask({it._id.eq(submission.value[0])})
					finishTask(task)
				</action>
			</actions>
		</event>
	</transition>
