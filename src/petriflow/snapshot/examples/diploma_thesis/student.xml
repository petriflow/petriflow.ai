	</transition>
	<transition>
		<id>t2</id>
		<x>140</x>
		<y>100</y>
		<layout>
			<offset>0</offset>
		</layout>
		<label>Test</label>
		<trigger type="auto"/>
		<event type="finish">
			<id>t2_finish</id>
			<actions phase="pre">
				<action>
				if (findCase{it.author.email.eq(useCase.author.email).and(it.processIdentifier.eq(useCase.processIdentifier)).and(it._id.ne(useCase._id))})
				{async.run {
							workflowService.deleteCase(useCase._id.toString())
							}
				 throw new Exception("Instance of this process already exists for the author")		
				}
				</action>
				<action>
					first_name: f.student_first_name,
					last_name: f.student_last_name,
					email: f.student_email,
					student: f.student_task_ref,
					autor: f.autor;
					change first_name value {
						userService.getLoggedOrSystem().name
					}
					change last_name value {
						userService.getLoggedOrSystem().surname
					}
					change email value {
						userService.getLoggedOrSystem().email
					}
					change student value {
						[useCase.tasks.find{it.transition=="t1"}?.task]
					}
					change autor value {
						[userService.getLoggedOrSystem().id]
					}
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>t3</id>
		<x>380</x>
		<y>100</y>
		<layout>
			<offset>0</offset>
		</layout>
		<label>Topic selection</label>
		<usersRef>
			<id>autor</id>
			<logic>
				<perform>true</perform>
			</logic>
		</usersRef>
		<dataGroup>
			<id>DataGroup_0</id>
			<dataRef>
				<id>student_task_ref</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<dataGroup>
			<id>DataGroup_1</id>
			<dataRef>
				<id>student_thesis_topics</id>
				<logic>
					<behavior>editable</behavior>
					<action trigger="get">
					topic: f.this;
					def topics = findCases { it.processIdentifier.eq("601fdf0a0a975a3b82912fd5_thesis").and(it.activePlaces.get("p3").eq(1))}.collectEntries { 
						[(it.stringId): "Thesis title: " + it.getFieldValue("thesis_title") + " Supervisor: " + it.getFieldValue("supervisor_first_name") + " " + it.getFieldValue("supervisor_last_name")] 
					}
					change topic options {
						topics
					}
					</action>
					<action trigger="set">
					topic_details: f.topic_details,
					topic: f.this;
					def zvolena_topic = findCase {it._id.eq(topic.value)}
					zvolena_topic.dataSet["student"].value = [useCase.tasks.find{it.transition=="t1"}?.task]
					workflowService.save(zvolena_topic)
					change topic_details value {
					[findTask {it.caseId.eq(topic.value).and(it.transitionId.eq("t1"))}?.stringId]
					}
				</action>
				</logic>
				<layout>
					<x>0</x>
					<y>2</y>
					<rows>2</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<dataGroup>
			<id>DataGroup_2</id>
			<dataRef>
				<id>topic_details</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>t3_finish</id>
			<actions phase="pre">
				<action>topic: f.student_thesis_topics;
						def task = findTask ({it.caseId.eq(topic.value).and(it.transitionId.eq("t4"))})
						async.run {
						assignTask(task);
						finishTask(task);
						}
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>t4</id>
		<x>620</x>
		<y>100</y>
		<layout>
