	<!-- PROCESS USER REFS -->
	<!-- DATA -->
	<data type="text">
		<id>text_0</id>
		<title>From</title>
	</data>
	<data type="text">
		<id>text_1</id>
		<title>To</title>
	</data>
	<data type="text">
		<id>text_2</id>
		<title>Body</title>
        <component>
            <name>htmltextarea</name>
        </component>
	</data>
	<data type="button">
		<id>button_0</id>
		<title></title>
		<placeholder>Send</placeholder>
		<action trigger="set">
email_from_field: f.text_0,
email_to_field: f.text_1,
email_body_field: f.text_2;

com.netgrif.workflow.mail.domain.MailDraft draft = com.netgrif.workflow.mail.domain.MailDraft
    .builder(email_from_field.value, [email_to_field.value])
    .body(email_body_field.value)
    .isHtml(true)
    .build()
sendMail(draft)
        </action>
	</data>
