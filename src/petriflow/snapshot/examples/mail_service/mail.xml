	<id>mail_test</id>
	<initials>MLT</initials>
	<title>Mail Test</title>
	<defaultRole>true</defaultRole>
	<transitionRole>false</transitionRole>
	<!-- TRANSACTIONS -->
	<!-- ROLES -->
