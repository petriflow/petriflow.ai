				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>student</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>1</rows>
					<cols>2</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>grade</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>2</y>
					<rows>1</rows>
					<cols>2</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>t8_finish</id>
			<actions phase="post">
				<action id="action_4">
					<![CDATA[
					student: f.student,
					                    grade: f.grade;
					                    def task = findTask({it._id.eq(student.value[0])})
					                    def a_case = findCase({it._id.eq(task.caseId)})
					                    setData("t7", a_case, ["student_grade": ["value": grade.value.toString(), "type": "text"]])
					]]>
				</action>
			</actions>
		</event>
	</transition>
