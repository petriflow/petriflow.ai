				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>student</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>1</rows>
					<cols>2</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>thesis</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>2</y>
					<rows>1</rows>
					<cols>2</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>t7_finish</id>
			<actions phase="pre">
				<action id="action_3">
					<![CDATA[
					student: f.student,
					                name: f.student_name,
					                surname: f.student_surname;
					                def task = findTask({it._id.eq(student.value[0])})
					                def a_case = findCase({it._id.eq(task.caseId)})
					                change name value { a_case.getFieldValue("student_first_name")}
					                change surname value { a_case.getFieldValue("student_last_name")}
					]]>
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>t8</id>
		<x>1264</x>
		<y>144</y>
		<label>Defence of thesis</label>
		<layout>
			<offset>0</offset>
		</layout>
		<dataGroup>
			<id>DataGroup_0</id>
			<dataRef>
				<id>topic</id>
