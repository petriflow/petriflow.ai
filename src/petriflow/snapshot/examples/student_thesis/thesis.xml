<document xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://petriflow.com/petriflow.schema.xsd">
	<id>thesis</id>
	<initials>PRC</initials>
	<title>Thesis</title>
	<defaultRole>false</defaultRole>
	<anonymousRole>false</anonymousRole>
	<transitionRole>false</transitionRole>
	<roleRef>
		<id>default</id>
		<caseLogic>
			<create>true</create>
			<delete>true</delete>
			<view>true</view>
		</caseLogic>
	</roleRef>
	<data type="text">
		<id>assignment</id>
		<title>Assignment</title>
		<placeholder>Thesis assignment</placeholder>
		<desc>Enter the thesis assignment text</desc>
		<component>
			<name>area</name>
		</component>
	</data>
	<data type="userList">
		<id>author</id>
		<title/>
	</data>
	<data type="enumeration">
		<id>grade</id>
		<title>Grade</title>
		<placeholder>Final grade</placeholder>
		<desc>Choose final grade</desc>
		<options>
			<option key="A">A</option>
			<option key="B">B</option>
			<option key="C">C</option>
			<option key="D">D</option>
			<option key="E">E</option>
			<option key="FX">FX</option>
			<option key="FN">FN</option>
		</options>
		<init>A</init>
	</data>
	<data type="taskRef">
		<id>student</id>
		<title>Student</title>
		<placeholder>Task reference to the student's task</placeholder>
		<desc>Task reference to the student's task</desc>
	</data>
	<data type="text">
		<id>student_name</id>
		<title>Student's name</title>
	</data>
	<data type="text">
		<id>student_surname</id>
		<title>Student's surname</title>
	</data>
	<data type="text">
		<id>supervisor_email</id>
		<title>Supervisor's email</title>
		<placeholder>Supervisor's email</placeholder>
		<desc>Enter the email of the supervisor</desc>
	</data>
	<data type="text">
		<id>supervisor_name</id>
		<title>Supervisor's name</title>
		<placeholder>Supervisor's name</placeholder>
		<desc>Enter the name of the thesis supervisor</desc>
	</data>
	<data type="text">
		<id>supervisor_surname</id>
		<title>Supervisor's surname</title>
		<placeholder>Supervisor's surname</placeholder>
		<desc>Enter the surname of the thesis supervisor</desc>
	</data>
	<data type="file">
		<id>thesis</id>
		<title>Thesis PDF</title>
		<placeholder> The file containing the thesis</placeholder>
		<desc>Upload the thesis PDF</desc>
	</data>
	<data type="text">
		<id>thesis_name</id>
		<title>Thesis topic title</title>
		<placeholder>Thesis topic title</placeholder>
		<desc>Enter the thesis topic title</desc>
	</data>
	<data type="taskRef">
		<id>topic</id>
		<title/>
		<init>t1</init>
	</data>
	<transition>
