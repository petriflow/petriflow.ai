	<transition>
		<id>t2</id>
		<x>176</x>
		<y>144</y>
		<label>Test</label>
		<layout>
			<offset>0</offset>
		</layout>
		<trigger type="auto"/>
		<event type="finish">
			<id>t2_finish</id>
			<actions phase="pre">
				<action id="action_0">
					<![CDATA[
					if (findCase{it.author.email.eq(useCase.author.email).and(it.processIdentifier.eq(useCase.processIdentifier)).and(it._id.ne(useCase._id))})
					                {async.run {
					                            workflowService.deleteCase(useCase._id.toString())
					                            }
					                 throw new Exception("Instance of this process already exists for the author")        
					                }
					]]>
				</action>
				<action id="action_1">
					<![CDATA[
					name: f.student_first_name,
					                    surname: f.student_last_name,
					                    email: f.student_email,
					                    author: f.author;
					                    change name value {
					                        userService.getLoggedOrSystem().name
					                    }
					                    change surname value {
					                        userService.getLoggedOrSystem().surname
					                    }
					                    change email value {
					                        userService.getLoggedOrSystem().email
					                    }
					                    change author value {
					                        [userService.getLoggedOrSystem().id]
					                    }
					]]>
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>t3</id>
		<x>400</x>
		<y>144</y>
		<label>Choosing a topic</label>
		<layout>
			<offset>0</offset>
		</layout>
		<userRef>
			<id>author</id>
			<logic>
				<perform>true</perform>
			</logic>
		</userRef>
		<dataGroup>
			<id>DataGroup_0</id>
			<dataRef>
				<id>student_ref</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>topic_detail</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>std_thesis_topics</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>2</y>
					<rows>2</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
				<event type="get">
					<id>get_event_0</id>
					<actions phase="pre">
						<action id="5">
							<![CDATA[
							topic: f.std_thesis_topics;
							                    def group_prefix = useCase.processIdentifier - useCase.processIdentifier.split("/").last();
							                    def list_of_topics = findCases { it.processIdentifier.eq(group_prefix + "thesis").and(it.activePlaces.get("p3").eq(1))}.collectEntries { 
							                        [(it.stringId): "Thesis name: " + it.getFieldValue("thesis_name") + " Supervisor: " + it.getFieldValue("supervisor_name") + " " + it.getFieldValue("supervisor_surname")] 
							                    }
							                    change topic options {
							                        list_of_topics
							                    }
							]]>
						</action>
					</actions>
				</event>
				<event type="set">
					<id>set_event_1</id>
					<actions phase="post">
						<action id="action_3">
							<![CDATA[
							topic_detail: f.topic_detail,
							                    topic: f.std_thesis_topics;
							                    def choosed_topic = findCase {it._id.eq(topic.value)}
							                    choosed_topic.dataSet["student"].value = [useCase.tasks.find{it.transition=="t1"}?.task]
							                    workflowService.save(choosed_topic)
							                    change topic_detail value {
							                    [findTask {it.caseId.eq(topic.value).and(it.transitionId.eq("t1"))}?.stringId]
							                    }
							]]>
						</action>
					</actions>
				</event>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>t3_finish</id>
			<actions phase="pre">
				<action id="action_4">
					<![CDATA[
					topics: f.std_thesis_topics;
					                        def task = findTask ({it.caseId.eq(topics.value).and(it.transitionId.eq("t4"))})
					                        async.run {
					                        assignTask(task);
					                        finishTask(task);
					                        }
					]]>
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>t4</id>
		<x>656</x>
		<y>144</y>
		<label>Confirmation of selected topic</label>
		<layout>
