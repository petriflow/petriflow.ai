		</layout>
	</transition>
	<transition>
		<id>t6</id>
		<x>880</x>
		<y>144</y>
		<label>Thesis submission</label>
		<layout>
			<offset>0</offset>
		</layout>
		<userRef>
			<id>author</id>
			<logic>
				<perform>true</perform>
			</logic>
		</userRef>
		<dataGroup>
			<id>DataGroup_0</id>
			<dataRef>
				<id>std_ref_thesis_submission</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="assign">
			<id>t6_assign</id>
			<actions phase="pre">
				<action id="action_5">
					<![CDATA[
					thesis_submission: f.std_ref_thesis_submission,
					                    topic: f.std_thesis_topics;
					                    change thesis_submission value {
					                    [findTask {it.caseId.eq(topic.value).and(it.transitionId.eq("t7"))}?.stringId]
					                    }
					]]>
				</action>
			</actions>
			<actions phase="post">
				<action id="action_6">
					<![CDATA[
					submission: f.std_ref_thesis_submission;
					                    def task = findTask({it._id.eq(submission.value[0])})
					                    assignTask(task)
					]]>
				</action>
			</actions>
		</event>
		<event type="cancel">
			<id>t6_cancel</id>
			<actions phase="pre">
				<action id="action_7">
					<![CDATA[
					submission: f.std_ref_thesis_submission;
					                    def task = findTask({it._id.eq(submission.value[0])})
					                    cancelTask(task)
					]]>
				</action>
			</actions>
		</event>
		<event type="finish">
			<id>t6_finish</id>
			<actions phase="pre">
				<action id="action_8">
					<![CDATA[
					submission: f.std_ref_thesis_submission;
					                    def task = findTask({it._id.eq(submission.value[0])})
					                    finishTask(task)
					]]>
				</action>
			</actions>
		</event>
	</transition>
