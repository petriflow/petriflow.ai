			</validation>
		</validations>
	</data>
	<data type="text">
		<id>text_0</id>
		<title>Min length</title>
		<validations>
			<validation>
				<expression>minLength 3</expression>
			</validation>
		</validations>
	</data>
	<data type="text">
		<id>text_1</id>
		<title>Max length</title>
		<validations>
			<validation>
				<expression>maxLength 10</expression>
			</validation>
		</validations>
	</data>
	<data type="text">
		<id>text_2</id>
		<title>Regex</title>
		<validations>
			<validation>
				<expression>regex ^[0-9]{6}[/]?[0-9]{3,4}$</expression>
				<message>Invalid national identification number</message>
			</validation>
		</validations>
	</data>
	<data type="text">
		<id>text_3</id>
		<title>Email</title>
		<validations>
			<validation>
				<expression>email</expression>
			</validation>
		</validations>
	</data>
