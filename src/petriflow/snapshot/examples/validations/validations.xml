	<id>validations</id>
	<initials>VAL</initials>
	<title>Validations</title>
	<icon>device_hub</icon>
	<defaultRole>true</defaultRole>
	<anonymousRole>true</anonymousRole>
	<transitionRole>false</transitionRole>
	<data type="number">
		<id>number_0</id>
		<title>Odd</title>
		<validations>
			<validation>
				<expression>odd</expression>
			</validation>
		</validations>
	</data>
