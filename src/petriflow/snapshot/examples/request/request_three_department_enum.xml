				<event type="set">
					<id>department_enumeration_set</id>
					<actions phase="post">
						<action id="7">
							<![CDATA[
							go_business: f.go_business,
							go_technical: f.go_technical,
							go_legal: f.go_legal,
							department_enumeration: f.department_enumeration;
							if (department_enumeration.value == "legal") {
								decision(go_legal, go_technical, go_business)
							}
							if (department_enumeration.value == "technical") {
								decision(go_technical, go_legal, go_business)
							}
							if (department_enumeration.value == "business") {
								decision(go_business, go_technical, go_legal)
							}
							]]>
						</action>
					</actions>
				</event>
			</dataRef>
