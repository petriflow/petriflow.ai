				<action id="8">
					<![CDATA[
					corrensponding_author: f.corrensponding_author,
					email: f.email,
					surname: f.surname,
					name: f.name;
					def user = userService.loggedOrSystem
					change name value { return user.name; }
					change surname value { return user.surname; }
					change email value { return user.email; }
					change corrensponding_author value { return [user.id]; }
					changeCaseProperty "title" about { "Paper of " + user.name + " " + user.surname; }
					]]>
