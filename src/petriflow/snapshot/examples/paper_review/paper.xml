				<action id="1">
					<![CDATA[
					reviewers: f.reviewers;
					def mapOptions = [:]
					findUsersByRole(useCase.getPetriNet().identifier, "reviewers").each{
					    mapOptions.put(it.stringId.toString(), it.email.toString())
					}
					change reviewers options { mapOptions }
					]]>
