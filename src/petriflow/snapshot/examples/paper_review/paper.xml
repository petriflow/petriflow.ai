			<actions phase="pre">
				<action id="2">
					<![CDATA[
					surname: f.surname,
					name: f.name,
					all_reviews: f.all_reviews,
					reviewers: f.reviewers;
					def reviewersTasks = []
					reviewers.value.each{ reviewerValue ->
					    def reviewer = findUserById(reviewerValue)
					    def reviewCase = createCase(workspace + "review", "Review of user " + reviewer.name + " " + reviewer.surname)
					    reviewersTasks.add(
