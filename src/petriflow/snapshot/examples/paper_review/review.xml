			<id>t1_finish</id>
			<actions phase="pre">
				<action id="1">paperCase: f.paperCase;

def pprCase = findCase({it._id.eq(paperCase.value)});
def currentReviewed = (int) pprCase.getDataField("currentReviewed").getValue()
currentReviewed = currentReviewed + 1
if( currentReviewed == pprCase.getDataField("all_reviews").getValue().size() ){
    def taskReviews = findTask(pprCase.tasks.find{it.transition=="t3"}?.task)
    assignTask(taskReviews);
    finishTask(taskReviews);
} else {
    pprCase.getDataField("currentReviewed").setValue(currentReviewed)
    workflowService.save(pprCase)
}</action>
			</actions>
		</event>
