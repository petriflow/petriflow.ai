					<rows>1</rows>
					<cols>1</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="assign">
			<id>0</id>
			<actions phase="pre">
				<action>
					appointment_ref: f.taskRef_0;

					def groupId = findCase{it.processIdentifier.eq("org_group").and(it.author.id.eq(loggedUser().id))}?.stringId
					def appointment = createCase("${groupId}_appointment_2")
					def task_builder = assignTask("2", appointment)
					change appointment_ref value {
						[task_builder.stringId]
					}
				</action>
			</actions>
		</event>
		<event type="finish">
			<id>1</id>
			<actions phase="pre">
				<action>
					appointments: f.enumeration_1,
					appointment_ref: f.taskRef_0;

					def task_builder = findTask(appointment_ref.value[0])
					def data = getData(task_builder)
					setData(task_builder, [
						"testing_site": [
					                "value": useCase.stringId as String,
									"type": "text"
					        ]
					])
					finishTask(task_builder)

					def appointment_name = "${data["date_0"].value}, ${data["enumeration_0"].value} - ${data["enumeration_1"].value}" as String
					change appointments options {
						appointments.options + [(task_builder.caseId):appointment_name]
					}
				</action>
			</actions>
		</event>
