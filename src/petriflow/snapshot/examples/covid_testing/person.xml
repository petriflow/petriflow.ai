        <label>Permanent address</label>
		<icon>home</icon>
		<assignPolicy>auto</assignPolicy>
        <dataGroup>
            <id>DataGroup_0</id>
            <layout>grid</layout>
            <dataRef>
                <id>taskRef_0</id>
