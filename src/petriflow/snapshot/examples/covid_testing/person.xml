                </layout>
            </dataRef>
        </dataGroup>
        <event type="finish">
            <id>8_finish</id>
            <actions phase="pre">
                <action>
					address_ref_visible: f.taskRef_1,
                    address_ref: f.taskRef_0;

					def task_builder = findTask(address_ref.value[0])
                    finishTask(task_builder)

					def edit_task = findTask({ it.caseId.eq(task_builder.caseId).and(it.transitionId.eq("8"))})
					change address_ref value {
						[edit_task.stringId]
					}
					def view_task = findTask({ it.caseId.eq(task_builder.caseId).and(it.transitionId.eq("4"))})
					change address_ref_visible value {
						[view_task.stringId]
					}
                </action>
            </actions>
        </event>
    </transition>
