                    <appearance>outline</appearance>
                </layout>
            </dataRef>
        </dataGroup>
        <event type="finish">
            <id>2_finish</id>
            <actions phase="pre">
                <action>
                    address_ref: f.taskRef_0;

                    def groupId = findCase{it.processIdentifier.eq("org_group").and(it.author.id.eq(loggedUser().id))}?.stringId
                    def address = createCase("${groupId}_address_2" as String)
                    def task_builder = assignTask("2", address)
                    change address_ref value {
                        [task_builder.stringId]
                    }
                </action>
            </actions>
        </event>
    </transition>
    <transition>
        <id>8</id>
        <x>540</x>
        <y>220</y>
        <layout>
