	<data type="enumeration_map">
		<id>enumeration_0</id>
		<title>Testing site</title>
		<init>option1</init>
		<action trigger="get">
			testing_sites: f.this;

			def groupId = findCase{it.processIdentifier.eq("org_group").and(it.author.id.eq(loggedUser().id))}?.stringId
			def sites = findCases({it.processIdentifier.eq("${groupId}_testing_site_2" as String)})
			change testing_sites options {
				sites.collectEntries {
					[(it.stringId): it.title]
				}
			}
		</action>
		<action trigger="set">
			appointments: f.enumeration_1,
			testing_sites: f.this;

			// TODO:
			def site = findCase({ it._id.eq(new org.bson.types.ObjectId(testing_sites.value))})
			change appointments options {
				//TODO:
				site.dataSet["enumeration_1"].options
			}
		</action>
	</data>
