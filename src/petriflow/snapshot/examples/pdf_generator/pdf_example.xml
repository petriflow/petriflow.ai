	<icon>picture_as_pdf</icon>
	<defaultRole>true</defaultRole>
	<transitionRole>false</transitionRole>
	<!-- TRANSACTIONS -->
	<!-- ROLES -->
	<!-- DATA -->
	<data type="text">
		<id>text_0</id>
		<title>Name</title>
	</data>
	<data type="text">
		<id>text_1</id>
		<title>Surname</title>
	</data>
	<data type="date">
		<id>date_0</id>
		<title>Date of birth</title>
	</data>
	<data type="enumeration">
		<id>enumeration_0</id>
		<title>Gender</title>
		<values>Man</values>
		<values>Woman</values>
	</data>
	<data type="enumeration">
		<id>enumeration_1</id>
		<title>Insurance type</title>
		<values>Buildings cover</values>
		<values>Contents cover</values>
		<values>Buildings &amp; Contents cover</values>
	</data>
	<data type="number">
		<id>number_0</id>
		<title>Buildings</title>
		<init>0</init>
	</data>
	<data type="number">
		<id>number_1</id>
		<title>Contents</title>
		<init>0</init>
	</data>
	<data type="file">
		<id>file_0</id>
		<title>PDF File</title>
	</data>
	<data type="button">
		<id>button_0</id>
		<title>Generate PDF</title>
	</data>
	<!-- I18NS -->
	<!-- TRANSITIONS -->
	<transition>
		<id>t1</id>
		<x>220</x>
		<y>100</y>
		<layout>
			<offset>0</offset>
		</layout>
		<label>Contract</label>
		<dataGroup>
			<id>DataGroup_0</id>
			<layout>grid</layout>
			<dataRef>
				<id>text_0</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>2</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>text_1</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>2</x>
					<y>0</y>
					<rows>1</rows>
					<cols>2</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>date_0</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>1</rows>
					<cols>2</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>enumeration_0</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>2</x>
					<y>1</y>
					<rows>1</rows>
					<cols>2</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>enumeration_1</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>2</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>number_0</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>3</y>
					<rows>1</rows>
					<cols>4</cols>
					<offset>0</offset>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
