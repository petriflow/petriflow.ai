	<version>1.0.0</version>
	<initials>MRT</initials>
	<title>Mortgage</title>
	<icon>device_hub</icon>
	<defaultRole>true</defaultRole>
	<anonymousRole>true</anonymousRole>
	<transitionRole>false</transitionRole>
	<roleRef>
		<id>appraiser</id>
		<caseLogic>
			<view>true</view>
		</caseLogic>
	</roleRef>
	<roleRef>
		<id>banker</id>
		<caseLogic>
			<view>true</view>
		</caseLogic>
	</roleRef>
