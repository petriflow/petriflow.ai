			<create>true</create>
		</caseLogic>
	</roleRef>
	<roleRef>
		<id>system</id>
		<caseLogic>
			<delete>true</delete>
			<view>true</view>
		</caseLogic>
	</roleRef>
	<userRef>
		<id>applicant</id>
		<caseLogic>
			<delete>true</delete>
			<view>true</view>
		</caseLogic>
	</userRef>
	<caseEvents>
		<event type="create">
			<id>mortgage_create</id>
			<actions phase="post">
				<action id="action18">
					<![CDATA[
					email: f.email,
					surname: f.surname,
					name: f.name,
					applicant: f.applicant;
					change name value { loggedUser().name; }
					change surname value { loggedUser().surname; }
					change email value { loggedUser().email; }
					change applicant value { [loggedUser().id]; }
					]]>
				</action>
			</actions>
		</event>
	</caseEvents>
	<role>
		<id>appraiser</id>
		<title>Property appraiser</title>
		<global>false</global>
	</role>
	<role>
		<id>banker</id>
		<title>Banker</title>
		<global>false</global>
	</role>
	<role>
		<id>system</id>
		<title>System</title>
		<global>false</global>
	</role>
	<function scope="process" name="calculation">
		<![CDATA[
		{amount_of_loan, time_period, payment -> 
		change payment value { amount.value / (time_period.value * 12); }
		}
		]]>
	</function>
	<data type="number">
		<id>amount</id>
		<title>Loan amount</title>
		<event type="set">
			<id>amount_set</id>
			<actions phase="post">
				<action id="action1">
					<![CDATA[
					monthly_payment: f.monthly_payment,
					period: f.period,
					amount: f.amount;
					calculation(amount, period, monthly_payment)
					]]>
				</action>
			</actions>
		</event>
	</data>
