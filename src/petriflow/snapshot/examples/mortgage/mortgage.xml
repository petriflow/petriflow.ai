				</layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>t1_finish</id>
			<actions phase="pre">
				<action id="action5">
					<![CDATA[
					state: f.state;
					change state value { "Your application was submitted"; }
					]]>
				</action>
			</actions>
			<actions phase="post">
				<action id="action3">
					<![CDATA[
					income: f.income,
					monthly_payment: f.monthly_payment;
					if (monthly_payment.value < income.value) {
						async.run{
						assignTask("t2")
						finishTask("t2")
					}
					}else {
						async.run{
						assignTask("t10")
						finishTask("t10")
					}
					}
					]]>
				</action>
			</actions>
		</event>
	</transition>
