				</layout>
			</dataRef>
			<dataRef>
				<id>decision</id>
				<logic>
					<behavior>editable</behavior>
					<behavior>required</behavior>
				</logic>
				<layout>
					<x>3</x>
					<y>0</y>
					<rows>1</rows>
					<cols>1</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>t3_finish</id>
			<actions phase="pre">
				<action id="3">
					<![CDATA[
					back: f.back,
					reject: f.reject,
					accept: f.accept,
					decision: f.decision;
					if (decision.value == "accept") {
						change accept value { 1; }
					    change reject value { 0; }
					    change back value { 0; }
					}
					if (decision.value == "reject") {
						change accept value { 0; }
					    change reject value { 1; }
					    change back value { 0; }
					}
					if (decision.value == "back") {
						change accept value { 0; }
					    change reject value { 0; }
					    change back value { 1; }
					}
					]]>
				</action>
			</actions>
		</event>
