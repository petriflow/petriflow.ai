		<event type="assign">
			<id>t1_assign</id>
			<actions phase="pre">
				<action id="action2">
					<![CDATA[
					invoice_approvals: f.invoice_approvals,
					children_invoice_cases: f.children_invoice_cases;
					// find approve task of invoices that are enabled to fire (have no user assigned)
					// and collect their IDs and store them in taskRef invoice_approvals
					change invoice_approvals value { 
					    findTasks{(it.caseId.in(children_invoice_cases.value)).and(it.transitionId.eq("t2").and(it.userId.isNull()))}?.collect{it.stringId}
					}
					// for each ID in the list find the task with that ID and assing that task
					invoice_approvals.value.each{ id_in_tasklist ->
					def invoice_to_approve = findTask({it._id.eq(id_in_tasklist)});
						assignTask(invoice_to_approve)
					}
					]]>
				</action>
			</actions>
		</event>
		<event type="finish">
			<id>t1_finish</id>
			<actions phase="pre">
				<action id="action1">
					<![CDATA[
					invoice_approvals: f.invoice_approvals,
					children_invoice_cases: f.children_invoice_cases;
					//remember IDs of approve tasks of invoices to approve
					def list_of_tasks_ids = invoice_approvals.value; 
					// set taskRef with list of ISs approve tasks of invoices to empty list
					change invoice_approvals value { []; } 
					// for each ID in remembered list find the task for ID and finish that task
					list_of_tasks_ids.each{ id_in_tasklist ->
					def invoice_to_approve = findTask({it._id.eq(id_in_tasklist)});
						finishTask(invoice_to_approve)
					}
					]]>
				</action>
			</actions>
		</event>
		<event type="cancel">
			<id>t1_cancel</id>
			<actions phase="pre">
				<action id="action3">
					<![CDATA[
					invoice_approvals: f.invoice_approvals;
					// for each ID in the list find the task with that ID and cancel that task
					invoice_approvals.value.each{ id_in_tasklist ->
					def invoice_to_approve = findTask({it._id.eq(id_in_tasklist)});
						cancelTask(invoice_to_approve)
					}
					]]>
				</action>
			</actions>
		</event>
	</transition>
